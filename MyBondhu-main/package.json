{
  "version": "1.0.0",
  "type": "module",
  "source": "./index.html",
  "name": "anima-project",
  "description": "A React project automatically generated by Anima using the Shadcn UI library",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:client": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "node server/index.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start:server": "node server/index.js",
    "build": "vite build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.0",
    "anima-project": "file:",
    "class-variance-authority": "^0.7.0",
    "clsx": "2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^0.453.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "concurrently": "^9.2.1",
    "esbuild": "0.27.3",
    "globals": "15.15.0",
    "tailwindcss": "3.4.16",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "alias": {
